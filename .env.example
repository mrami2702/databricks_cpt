# Environment variable template for the Databricks Scientific Assistant.
# Copy to .env and fill in your values. The top section covers the CPT/SFT training
# pipeline; the "Multi-Agent System" section covers the agents/ directory.
# Required: DATABRICKS_HOST, DATABRICKS_TOKEN, DATABRICKS_HTTP_PATH, GOOGLE_CLOUD_PROJECT.
# Optional: SERPER_API_KEY (disables GoogleScholarAgent if missing), FINE_TUNED_ENDPOINT (deferred).

# Databricks Configuration
# Get your token from: User Settings > Developer > Access Tokens
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token

# Unity Catalog location of your training data
DATABRICKS_CATALOG=your_catalog
DATABRICKS_SCHEMA=your_schema
DATABRICKS_TABLE=your_documents_table

# Column name containing the text content
TEXT_COLUMN=text_content

# MLflow tracking (optional - defaults to local)
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_NAME=/Users/your-email/cpt-poc

# ============================================================
# Multi-Agent System (agents/)
# ============================================================

# SQL Warehouse HTTP path — found in cluster config > JDBC/ODBC tab
# Format: /sql/1.0/warehouses/<warehouse-id>
# DATABRICKS_WAREHOUSE_ID is derived from this automatically — no need to set it separately
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Workspace paths for EDA and Genie notebooks (upload notebooks/*.py to Databricks first)
# Default values work if you upload to /Shared/; override if you upload elsewhere
# EDA_NOTEBOOK_PATH=/Shared/eda_notebook
# GENIE_NOTEBOOK_PATH=/Shared/genie_notebook
# AUTOML_NOTEBOOK_PATH=/Shared/automl_notebook

# GCP Vertex AI — used to run Claude models via Anthropic on Vertex
# Run `gcloud auth application-default login` on dev machines
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Claude model string for Vertex AI (format: model-name@version)
CLAUDE_MODEL=claude-sonnet-4-5@20251101

# Serper API key for Google Scholar search (https://serper.dev)
SERPER_API_KEY=your-serper-api-key

# ============================================================
# Deferred — for scientific_advisor_agent (see TODO_scientific_advisor.md)
# ============================================================
# Fine-tuned Mistral serving endpoint name (just the name, not full URL)
# Example: if endpoint URL ends in .../serving-endpoints/mistral-sft/invocations
# set this to: mistral-sft
# FINE_TUNED_ENDPOINT=mistral-sft
